# Upgrade-lab cluster only (Lab 2.6)
# Source together with workshop.env or copy values into workshop.env
# EKS: i8g.2xlarge + NODE_ZONE / UPGRADE_LAB_NODE_ZONE
# GKE: n2-highmem-8; zone defaults to first CLUSTER_ZONES entry unless UPGRADE_LAB_NODE_ZONE is set

UPGRADE_LAB_CLUSTER_NAME=my-cluster-k8s-upgrade
UPGRADE_LAB_K8S_VERSION_START=1.34
UPGRADE_LAB_K8S_VERSION_TARGET=1.35
UPGRADE_LAB_NODE_COUNT=3
UPGRADE_LAB_NODE_TYPE=i8g.2xlarge
UPGRADE_LAB_AEROSPIKE_SIZE=3
UPGRADE_LAB_NODEGROUP_NAME=ng-upgrade-lab
UPGRADE_LAB_NODE_ZONE=us-east-1c
