# GKE Standard workshop cluster environment
# Copy to workshop.env and customize:
#   cp scripts/env/workshop.env.gke.example scripts/env/workshop.env
# Never commit workshop.env.

CLOUD_PROVIDER=gke
NODE_PROVISIONING=nodepool         # GKE node pools only (Karpenter is AWS-only)
CLUSTER_NAME=my-cluster
GCP_PROJECT=your-gcp-project
GCP_REGION=us-central1
CLUSTER_ZONES=us-central1-a,us-central1-b
DEPLOY_PATH=olm                    # olm | helm

# Section 1 Lab 1.1 + Section 2 cluster storage (disk = local-ssd device; dim = in-memory)
CLUSTER_STORAGE=disk               # disk | dim
CLUSTER_STORAGE_DIM_LABS=
CLUSTER_STORAGE_DISK_LABS=

MIN_NODES_PER_ZONE=2
NODEGROUP_NAME=ng-aerospike
NODEGROUP_NAME_VERTICAL=ng-aerospike-4xl
NODE_TYPE=n2-highmem-8
NODE_TYPE_VERTICAL=n2-highmem-16
NODE_COUNT=4
NVME_DISK_LAYOUT=
K8S_VERSION=1.33

GKE_SYSTEM_NODEGROUP=default-pool
GKE_SYSTEM_NODE_TYPE=e2-standard-4
GKE_SYSTEM_NODE_COUNT=2
GKE_LOCAL_SSD_COUNT=3
GKE_LOCAL_SSD_COUNT_VERTICAL=6

# Upgrade-lab cluster (Lab 2.6 only)
UPGRADE_LAB_CLUSTER_NAME=my-cluster-k8s-upgrade
UPGRADE_LAB_K8S_VERSION_START=1.31
UPGRADE_LAB_K8S_VERSION_TARGET=1.32
UPGRADE_LAB_NODE_COUNT=3
UPGRADE_LAB_NODE_TYPE=n2-highmem-8
UPGRADE_LAB_AEROSPIKE_SIZE=3
UPGRADE_LAB_NODEGROUP_NAME=ng-upgrade-lab

# All-flash cluster (Section 4 only) — opt-in third cluster: setup-all.sh --step 0.8
# Each of the 16 local NVMe disks is split by nvme-bootstrap into a 40 GiB ext4 index
# slice (37.5 GiB claimed × 16 = 600 GiB per node) and a raw data slice.
ALL_FLASH_CLUSTER_NAME=my-cluster-all-flash
ALL_FLASH_NODEGROUP_NAME=ng-all-flash
ALL_FLASH_NODE_TYPE=n2-highmem-16
ALL_FLASH_GKE_LOCAL_SSD_COUNT=16
ALL_FLASH_NODE_COUNT=3              # Lab 4.1 starting size
ALL_FLASH_NODE_COUNT_SCALED=4       # Lab 4.2 scales the pool to this size
ALL_FLASH_AEROSPIKE_SIZE=3
ALL_FLASH_AEROSPIKE_SIZE_SCALED=4
ALL_FLASH_NVME_DISK_LAYOUT=n2-highmem-16-all-flash  # key in config/disk-layouts.yaml
ALL_FLASH_INDEX_MOUNTS_BUDGET=644245094400          # 600 GiB of primary index per node
ALL_FLASH_AKO_VERSION=4.5.0                         # Section 4 is not on the Lab 2.2 ladder

# AKO versions
AKO_VERSION_START=4.2.0
AKO_VERSION_TARGET=4.5.0
AKO_UPGRADE_LADDER=4.2.0,4.3.0,4.4.1,4.5.0
AKO_MIN_VERSION_REPLICATION_FACTOR=4.4.0
AKO_CLUSTER_CHART_VERSION=

# OLM / Helm
OLM_VERSION=v0.43.0
HELM_REPO=https://aerospike.github.io/aerospike-kubernetes-enterprise
HELM_OPERATOR_RELEASE=aerospike-kubernetes-operator
HELM_CLUSTER_RELEASE=aerocluster

# Namespaces
NAMESPACE=aerospike
OPERATOR_NAMESPACE=operators

# Paths (relative to workshop/)
OPERATOR_REPO=aerospike-kubernetes-operator
FEATURES_CONF_PATH=secrets/features.conf

# Aerospike Database
AEROSPIKE_VERSION=8.1.0
AEROSPIKE_IMAGE=aerospike/aerospike-server-enterprise:8.1.0.0
AEROSPIKE_UPGRADE_IMAGE=aerospike/aerospike-server-enterprise:8.1.2.0

# Data load
MIGRATION_LOAD_NAMESPACE=test
MIGRATION_LOAD_RECORDS=5000000
MIGRATION_LOAD_OBJECT_SIZE=1024
MIGRATION_LOAD_THREADS=64

# Continuous workload
WORKLOAD_TPS=10000
WORKLOAD_THREADS=64
WORKLOAD_NAMESPACE=test
WORKLOAD_RECORDS=5000000
WORKLOAD_OBJECT_SIZE=1024
WORKLOAD_DURATION=86400

# Section 3 — Aerospike client TLS
AEROSPIKE_TLS_MODE=plain
AEROSPIKE_TLS_NAME=aerocluster
AEROSPIKE_TLS_PORT=4333
TLS_CLUSTER_NAME=aerocluster
